APP_PORT=3000

# Long random string (e.g. `openssl rand -hex 32`). Used to sign and verify JWTs.
SECRET=

# `production` disables DATABASE_SYNCHRONIZE regardless of its value below
# and is the only value that gates dev-only behavior. Leave blank or set
# to `development` in dev.
NODE_ENV=development

# Database Configuration
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=mentimeter
DATABASE_PASSWORD=mentimeter
DATABASE_NAME=mentimeter_db
# Auto-sync entity schema to the DB on boot. Dev-only escape hatch — keep
# off and run `npm run migration:run` after `migration:generate` instead,
# so the migration history captures every schema change. Ignored entirely
# when NODE_ENV=production.
DATABASE_SYNCHRONIZE=false

# Comma-separated list of allowed CORS origins. Leave empty for `*` (dev).
# In production, set explicitly: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
