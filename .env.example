APP_PORT=3000

# Long random string (e.g. `openssl rand -hex 32`). Used to sign and verify JWTs.
SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL_GOOGLE=http://localhost:3000/authentication/success

# Database Configuration
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=mentimeter
DATABASE_PASSWORD=mentimeter
DATABASE_NAME=mentimeter_db
# True only in dev — auto-syncs schema from entities, can drop columns/data.
DATABASE_SYNCHRONIZE=true
